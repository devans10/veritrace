# Copy to .env (gitignored) or run `make env` to generate random secrets.
# Any setting can also be supplied as <NAME>_FILE=/path/to/secret.

ENV=development
LOG_LEVEL=INFO
API_BIND=127.0.0.1
API_PORT=8000

# Postgres: owner runs migrations; the app role gets least privilege.
DB_OWNER_PASSWORD=change-me
APP_DB_PASSWORD=change-me

REDIS_PASSWORD=change-me

# Object store (SeaweedFS S3 gateway locally; any S3-compatible endpoint works).
S3_ACCESS_KEY=change-me
S3_SECRET_KEY=change-me

# Internet Archive Save Page Now 2. Keys: https://archive.org/account/s3.php
# Saving a URL makes it publicly visible in the Wayback Machine.
ARCHIVE_PROVIDER=wayback
ARCHIVE_SAVE_ENABLED=true
IA_S3_ACCESS_KEY=
IA_S3_SECRET_KEY=

# ---- LLM (claim extraction) ----
# anthropic (default) uses the native Messages API via the `anthropic` SDK.
# openai_compat points at any OpenAI-compatible endpoint (vLLM, LM Studio, Ollama, LiteLLM).
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-6
LLM_PROMPT_CACHE=true
# For openai_compat only:
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=

# ---- Embeddings ----
# voyage (default, needs VOYAGE_API_KEY); local uses sentence-transformers (install .[local-embed]).
# EMBED_DIM MUST match the pgvector column size; the migration reads it at `make up`.
EMBED_PROVIDER=voyage
EMBED_MODEL=voyage-3
EMBED_DIM=1024
VOYAGE_API_KEY=

# ---- Search (claim corroboration) ----
SEARCH_PROVIDER=searxng
SEARXNG_URL=http://searxng:8080

# ---- Fact check (Google Fact Check Tools) ----
FACTCHECK_PROVIDER=none
GOOGLE_API_KEY=

# ---- Domain info (RDAP, used by the source investigator) ----
DOMAININFO_PROVIDER=rdap
RDAP_BOOTSTRAP_URL=https://rdap.iana.org/domain

# ---- Reverse image search (self-building local pHash index) ----
REVERSE_IMAGE_PROVIDER=local_phash
PHASH_SIMILARITY_THRESHOLD=8   # Hamming distance; 0 = identical, 64 = max
PHASH_MAX_IMAGES_PER_CASE=20

# ---- Uploads ----
UPLOAD_MAX_BYTES=26214400              # 25 MB
UPLOAD_ALLOWED_MIMES=image/jpeg,image/png,image/webp,image/gif,video/mp4

# ---- Media forensics ----
MEDIA_MAX_IMAGES_PER_CASE=5
ELA_JPEG_QUALITY=90                    # re-save quality for Error Level Analysis

# ---- Scoring ----
SCORING_CONFIG_PATH=config/scoring.yaml

# ---- SSRF / fetch policy ----
# EGRESS_PROXY_URL defaults to http://egress-proxy:4750 inside compose.
# FETCH_ALLOWED_PORTS defaults to "80,443".
# FETCH_MAX_BYTES defaults to 10 MB. FETCH_TIMEOUT_S defaults to 20.
# SSRF_ALLOW_CIDRS is DEV/TEST ONLY — ENV=production refuses it.

# ---- Curated seed lists ----
SOURCES_DIR=config/sources

# ---- Result caching ----
# RESULT_CACHE_TTL_S defaults to 6 hours; subsequent URL submissions within
# the TTL return the previous case id unless the client sets refresh=true.
