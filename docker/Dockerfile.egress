# Smokescreen egress proxy (Stripe). Official release binary, pinned by sha256.
# Blocks private/loopback/link-local destinations by default.
FROM debian:bookworm-slim AS fetch
ARG SMOKESCREEN_VERSION=v0.1.0
ARG SMOKESCREEN_SHA256=4e1e447449e3cc653dae956208588722b5c8fe8ce894f633adc756a851d1ec46
RUN apt-get update && apt-get install -y --no-install-recommends curl ca-certificates \
    && rm -rf /var/lib/apt/lists/*
RUN curl -fsSL -o /tmp/s.tgz \
      "https://github.com/stripe/smokescreen/releases/download/${SMOKESCREEN_VERSION}/smokescreen_${SMOKESCREEN_VERSION}_linux_amd64.tar.gz" \
    && echo "${SMOKESCREEN_SHA256}  /tmp/s.tgz" | sha256sum -c - \
    && mkdir /out && tar -xzf /tmp/s.tgz -C /out && find /out -maxdepth 2 -type f

FROM debian:bookworm-slim
COPY --from=fetch /out/ /opt/smokescreen/
RUN ln -s "$(find /opt/smokescreen -type f -name smokescreen | head -1)" /usr/local/bin/smokescreen
USER nobody
EXPOSE 4750
ENTRYPOINT ["smokescreen"]
